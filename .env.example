# Backblaze B2 (required)
B2_ENDPOINT=your_b2_endpoint
B2_REGION=your_b2_region
B2_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_application_key
B2_BUCKET_NAME=your-bucket-name

# Example of what filled-in values look like (fake — for visual reference only):
# B2_ENDPOINT=https://s3.<your-region>.backblazeb2.com
# B2_REGION=<your-region>            # the region segment of your endpoint
# B2_KEY_ID=<your-keyID-from-the-B2-dashboard>
# B2_APPLICATION_KEY=<your-applicationKey-shown-once-on-creation>
# B2_BUCKET_NAME=my-avatar-projects

# Optional: public base URL if your bucket is served publicly (otherwise leave blank
# and the app uses short-lived presigned URLs for every read/stream).
# B2_PUBLIC_URL=

# Avatar-video provider (required to render video; not needed just to browse)
# AVATAR_PROVIDER selects the render adapter. Default is "did" (D-ID).
AVATAR_PROVIDER=did
# D-ID API key — the default provider. Free 14-day trial, ~20 credits (≈5 min of
# video), no credit card; renders are watermarked on the trial tier.
DID_API_KEY=your_did_api_key
# Optional alternate provider. Set AVATAR_PROVIDER=fal to use FAL's lip-sync
# models ($20 free signup credits, pay-per-use); then provide:
# FAL_KEY=your_fal_key
# Optional provider voice id / stock avatar (presenter) id. Leave blank to use
# the provider defaults.
AVATAR_DEFAULT_VOICE=
AVATAR_DEFAULT_AVATAR=
# Render poll loop tuning (optional).
# AVATAR_POLL_INTERVAL_SECONDS=3
# AVATAR_POLL_TIMEOUT_SECONDS=600
